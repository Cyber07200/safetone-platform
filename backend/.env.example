# ---------------------------------------------------------------------------
# SafeTone backend configuration. Copy to backend/.env and fill in.
# NEVER commit backend/.env — it is listed in .gitignore.
# ---------------------------------------------------------------------------

# demo | live — default mode shown in the UI (Live requires at least one provider)
SAFETONE_MODE=demo
# SQLite for local demo; PostgreSQL for production, e.g.
# DATABASE_URL=postgresql+psycopg://safetone:password@localhost:5432/safetone
DATABASE_URL=sqlite:///./safetone.db
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_SEED_DEMO=true
LOG_LEVEL=INFO

# Limits
MAX_QUESTION_CHARS=2000
MAX_ANSWER_CHARS=8000
MAX_UPLOAD_BYTES=10485760

# --- AI routing --------------------------------------------------------------
# auto | yandex | gigachat | openai
DEFAULT_AI_PROVIDER=auto
AI_REQUEST_TIMEOUT_S=30
AI_MAX_RETRIES=1

# --- Yandex AI Studio (YandexGPT) --------------------------------------------
# API key of a service account with the ai.languageModels.user role (or an IAM token)
YANDEX_API_KEY=
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
# Optional: full model URI, e.g. gpt://<folder_id>/yandexgpt/latest (default: yandexgpt-lite/latest)
YANDEX_MODEL_URI=
YANDEX_BASE_URL=https://llm.api.cloud.yandex.net/foundationModels/v1
# Your contract price per 1K tokens (optional, used only for cost estimates and routing)
YANDEX_COST_PER_1K_TOKENS=

# --- GigaChat -------------------------------------------------------------------
# Authorization key from the GigaChat personal account (base64 of client_id:client_secret),
# or client id + secret separately
GIGACHAT_AUTH_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# GIGACHAT_API_PERS | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat/v1
# Path to the Russian Trusted Root CA bundle if TLS verification fails
GIGACHAT_CA_BUNDLE=
GIGACHAT_COST_PER_1K_TOKENS=

# --- Any OpenAI-compatible API --------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_PROVIDER_LABEL=OpenAI-compatible
OPENAI_COST_PER_1K_TOKENS=
