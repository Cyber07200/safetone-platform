# ---------------------------------------------------------------------------
# SafeTone backend configuration. Copy to backend/.env and fill in.
# NEVER commit backend/.env — it is listed in .gitignore.
# ---------------------------------------------------------------------------

# demo | live — default mode shown in the UI (Live requires GigaChat credentials)
SAFETONE_MODE=demo
# SQLite for a local demo, or Supabase / any PostgreSQL. For Supabase use the
# Session pooler string (Project → Connect), e.g.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./safetone.db
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_SEED_DEMO=true
LOG_LEVEL=INFO

# Limits
MAX_QUESTION_CHARS=2000
MAX_ANSWER_CHARS=8000
MAX_UPLOAD_BYTES=10485760

# --- AI --------------------------------------------------------------------
# auto | gigachat
DEFAULT_AI_PROVIDER=auto
AI_REQUEST_TIMEOUT_S=30
AI_MAX_RETRIES=1

# --- GigaChat (рекомендуется: бесплатный Freemium для физлиц) -------------------
# Ключ: https://developers.sber.ru/studio → проект GigaChat API → «Получить ключ».
# Freemium для физлиц включает GigaChat-3-Ultra (лимиты — на странице тарифов Сбера).
# Authorization key from the GigaChat personal account (base64 of client_id:client_secret),
# or client id + secret separately
GIGACHAT_AUTH_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# GIGACHAT_API_PERS | GIGACHAT_API_B2B | GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GigaChat (базовая) или GigaChat-3-Ultra (сильнее; во Freemium для физлиц)
GIGACHAT_MODEL=GigaChat
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat/v1
# Path to the Russian Trusted Root CA bundle if TLS verification fails
GIGACHAT_CA_BUNDLE=
GIGACHAT_COST_PER_1K_TOKENS=

# --- Chat history encryption (AES-256-GCM) ------------------------------------
# Required for the chat. 32 random bytes in base64; keep it secret and back it up:
# without this key stored conversations cannot be decrypted.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CHAT_ENCRYPTION_KEY=
# How many recent messages are sent to GigaChat verbatim (older ones are summarised)
CHAT_HISTORY_WINDOW=20
MAX_CHAT_MESSAGE_CHARS=4000
